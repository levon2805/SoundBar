<Window x:Class="SoundBar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="using:SoundBar.Helpers">

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
            BorderThickness="1">
        <Border.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- Muted red: darker on light backgrounds and softer on dark ones, so it's easy to read in both -->
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="DimmingOverlayBrush" Color="#D8EAEAEA" />
                        <SolidColorBrush x:Key="MuteTrueBrush" Color="#C42B1C" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="DimmingOverlayBrush" Color="#D8202020" />
                        <SolidColorBrush x:Key="MuteTrueBrush" Color="#FF6B6B" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="DimmingOverlayBrush" Color="#D8202020" />
                        <SolidColorBrush x:Key="MuteTrueBrush" Color="#FF6B6B" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="FocusTrueBrush" Color="#280078D7"/>
                <SolidColorBrush x:Key="FocusFalseBrush" Color="Transparent"/>

                <!-- Settings page building blocks (plain text and layout only, so no control templates are replaced) -->
                <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Setter Property="Margin" Value="2,14,0,2"/>
                </Style>
                <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
                <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
                <Style x:Key="SettingsCardStyle" TargetType="Grid">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="MinHeight" Value="48"/>
                </Style>

                <helpers:BoolToBrushConverter x:Key="FocusedToBrushConverter"
                                             TrueBrush="{StaticResource FocusTrueBrush}"
                                             FalseBrush="{StaticResource FocusFalseBrush}"/>
                <!-- Muted/unmuted are separate elements so the unmuted one can use ThemeResource directly.
                     A ThemeResource passed through a converter gets stuck on the startup theme. -->
                <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True"/>
            </ResourceDictionary>
        </Border.Resources>

        <Grid>
            <!-- Background Image Layer -->
            <!-- Source is set from code so the picture can be decoded at window size rather than full size -->
            <Image x:Name="BackgroundImageControl" Stretch="UniformToFill" />
            <!-- Dimming Overlay Layer -->
            <Border Background="{ThemeResource DimmingOverlayBrush}" />

            <!-- Application Content -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="0,0,0,15" Padding="20,20,20,0" Background="Transparent" Canvas.ZIndex="10">
                <!-- Title, then: ⋯ menu, Settings, [classic: Pin, Companion, Bluetooth], DND, Minimise, Close.
                     Hidden buttons take up no room. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Shrinks (never grows) the title when the classic title bar's buttons leave it too little room,
                     rather than cutting it off part-way through the name -->
                <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock x:Name="AppTitleText"
                               Text="SoundBar" 
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                               Margin="0"
                               FontSize="20"
                               FontWeight="Bold"/>
                </Viewbox>



                <Button x:Name="UpdateButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Margin="0"
                        Height="32"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        Background="#1A4CAF50"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Click="UpdateBanner_Click"
                        Visibility="{x:Bind ViewModel.UpdateBannerVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.UpdateBannerText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE896;" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="Update Available" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                
                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        Content="&#xE713;" 
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Width="36" Height="36"
                        Padding="0" MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderThickness="0"
                        FontSize="14"
                        Margin="0,0,5,0"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"/>

                <!-- More menu: keeps the title bar tidy on small windows. Each item can be hidden in Layout Settings,
                     or the classic title bar (separate buttons) can be switched back on there. -->
                <Button x:Name="MoreButton"
                        Grid.Column="1"
                        Content="&#xE712;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Width="36" Height="36"
                        Padding="0" MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderThickness="0"
                        FontSize="14"
                        Margin="0,0,5,0"
                        Visibility="{x:Bind ViewModel.MoreMenuVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem x:Name="PinMenuItem"
                                                  Text="Always on Top"
                                                  Click="PinButton_Click"
                                                  Visibility="{x:Bind ViewModel.PinButtonVisibility, Mode=OneWay}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutItem Text="Mobile Companion"
                                            Click="CompanionButton_Click"
                                            Visibility="{x:Bind ViewModel.CompanionButtonVisibility, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8EA;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Bluetooth"
                                            Click="BluetoothButton_Click"
                                            Visibility="{x:Bind ViewModel.BluetoothButtonVisibility, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE702;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Classic title bar: the ⋯ menu's items as their own buttons, as before v4.3.0 -->
                <Button x:Name="PinButton"
                        Grid.Column="3"
                        Content="&#xE718;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Width="36" Height="36"
                        Padding="0" MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        BorderThickness="0"
                        FontSize="16"
                        Margin="0,0,5,0"
                        Click="PinButton_Click"
                        Visibility="{x:Bind ViewModel.ClassicPinButtonVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Always on Top" AutomationProperties.Name="Always on Top"/>

                <Button Grid.Column="4"
                        Content="&#xE8EA;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Width="36" Height="36"
                        Padding="0" MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderThickness="0"
                        FontSize="16"
                        Margin="0,0,5,0"
                        Click="CompanionButton_Click"
                        Visibility="{x:Bind ViewModel.ClassicCompanionButtonVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Mobile Companion" AutomationProperties.Name="Mobile Companion"/>

                <Button Grid.Column="5"
                        Content="&#xE702;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Width="36" Height="36"
                        Padding="0" MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderThickness="0"
                        FontSize="16"
                        Margin="0,0,5,0"
                        Click="BluetoothButton_Click"
                        Visibility="{x:Bind ViewModel.ClassicBluetoothButtonVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Bluetooth" AutomationProperties.Name="Bluetooth"/>

                <ToggleButton x:Name="DndToggleButton"
                              Grid.Column="6"
                              Content="&#xE708;" 
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Width="36" Height="36"
                              Padding="0" MinWidth="0" MinHeight="0"
                              Background="Transparent"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              BorderThickness="0"
                              FontSize="14"
                              Margin="0,0,5,0"
                              IsChecked="{x:Bind ViewModel.IsDoNotDisturbEnabled, Mode=TwoWay}"
                              Checked="DndToggleButton_Changed"
                              Unchecked="DndToggleButton_Changed"
                              ToolTipService.ToolTip="Do Not Disturb (Mute System Sounds)" AutomationProperties.Name="Do Not Disturb (Mute System Sounds)"/>

                <Button x:Name="MinimizeButton"
                        Grid.Column="7"
                        Content="&#xE921;" 
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Width="36" Height="36"
                        Padding="0" MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderThickness="0"
                        FontSize="14"
                        Click="MinimizeButton_Click"
                        ToolTipService.ToolTip="Minimise" AutomationProperties.Name="Minimise"/>

                <Button Grid.Column="8"
                        Content="&#xE711;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Width="36" Height="36"
                        Padding="0" MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderThickness="0"
                        FontSize="14"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close" AutomationProperties.Name="Close"/>
            </Grid>

            <!-- Main Content -->
            <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- MIXER VIEW -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{x:Bind ViewModel.MixerViewVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">

                    <Border Background="#66FF0000"
                            BorderBrush="#FF5555"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,0,15"
                            Padding="10"
                            Visibility="{x:Bind ViewModel.LoudnessWarningVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xEA39;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Text="Volume has been very high for a while. Protect your hearing!" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Width="200"/>
                            <Button Content="Dismiss" Background="{ThemeResource ControlFillColorSecondaryBrush}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" VerticalAlignment="Center" Click="DismissLoudnessWarning_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Combined I/O Device Strip -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OutputColumnDef" Width="*"/>
                            <ColumnDefinition x:Name="MuteButtonColumnDef" Width="Auto"/>
                            <ColumnDefinition x:Name="InputColumnDef" Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Output Device Picker -->
                        <ComboBox x:Name="DeviceComboBox"
                                  Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AudioDevices}"
                                  SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  PlaceholderText="No output devices detected"
                                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Margin="0,0,6,0"
                                  Visibility="{x:Bind ViewModel.OutputDeviceVisibility, Mode=OneWay}"/>

                        <Button x:Name="MicMuteButton"
                                Grid.Column="1"
                                Margin="0,0,6,0"
                                Width="36" Height="32"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                CornerRadius="4"
                                Click="MicMuteButton_Click"
                                Visibility="{x:Bind ViewModel.InputDeviceVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="Mute/Unmute Microphone" AutomationProperties.Name="Mute/Unmute Microphone">
                            <Grid>
                                <!-- Live mic -->
                                <TextBlock Text="&#xE720;"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           Visibility="{Binding IsInputMuted, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <!-- Muted mic -->
                                <TextBlock Text="&#xF12E;"
                                           Foreground="{ThemeResource MuteTrueBrush}"
                                           FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           Visibility="{Binding IsInputMuted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Input Device Picker -->
                        <ComboBox x:Name="InputDeviceComboBox"
                                  Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="100"
                                  ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  PlaceholderText="No input devices detected"
                                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind ViewModel.InputDeviceVisibility, Mode=OneWay}"/>
                    </Grid>

                    <!-- Master Volume -->
                    <StackPanel Visibility="{x:Bind ViewModel.MasterVolumeVisibility, Mode=OneWay}">
                        <TextBlock Text="Master Volume" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                    Minimum="0" 
                                    Maximum="100" 
                                    Value="{Binding MasterVolumePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="1" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right">
                                <Run Text="{Binding MasterVolumePercentage}" /><Run Text="%" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,20,0,10"/>

                    <!-- Active Apps Header + List -->
                    <StackPanel x:Name="ActiveAppsHeaderPanel" Visibility="{x:Bind ViewModel.ActiveAppsVisibility, Mode=OneWay}">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Active Apps" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Click="RefreshApps_Click"
                                    Background="Transparent" 
                                    BorderBrush="Transparent"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Force refresh audio sessions" AutomationProperties.Name="Force refresh audio sessions"
                                    Padding="4">
                                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <ListView Grid.Row="1" Margin="0,0,-16,0" Padding="0,0,16,0" 
                          Visibility="{x:Bind ViewModel.ActiveAppsVisibility, Mode=OneWay}"
                          ItemsSource="{Binding Apps}" 
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,15" Background="{Binding IsHighlightVisible, Converter={StaticResource FocusedToBrushConverter}}" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- The "Hide" glyph (ED1A) isn't in the Windows 10 icon font, so draw it as
                                         the "View" eye (in both fonts) with a slash across it -->
                                    <Button Grid.Column="0"
                                            Background="Transparent"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                            BorderThickness="0" 
                                            Click="HideAppButton_Click" 
                                            ToolTipService.ToolTip="Hide App" AutomationProperties.Name="Hide App"
                                            Padding="0" MinWidth="20" Height="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,5,0">
                                        <Grid Width="16" Height="16">
                                            <FontIcon Glyph="&#xE890;" FontSize="14"/>
                                            <PathIcon Data="M2,2.7 L2.7,2 L14,13.3 L13.3,14 Z"/>
                                        </Grid>
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{Binding AppIcon}" Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform" Tapped="AppIcon_Tapped" ToolTipService.ToolTip="Click to Mute"/>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" 
                                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 MinHeight="0"
                                                 MinWidth="0"
                                                 Padding="0"
                                                 Margin="0"
                                                 KeyDown="TextBox_KeyDown"
                                                 ToolTipService.ToolTip="Click to rename"/>
                                    </StackPanel>

                                    <Slider Grid.Column="2" 
                                            Minimum="0" 
                                            Maximum="100" 
                                            Value="{Binding VolumePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="10,0"/>

                                    <!-- Volume % -->
                                    <TextBlock Grid.Column="3"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding IsMuted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Run Text="{Binding VolumePercentage}" /><Run Text="%" />
                                    </TextBlock>

                                    <!-- Muted icon -->
                                    <TextBlock Grid.Column="3"
                                               Text="&#xE74F;"
                                               FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                               Foreground="{ThemeResource MuteTrueBrush}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                </ListView>
                </Grid>

                <!-- MUSIC PLAYER VIEW -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{x:Bind ViewModel.MusicPlayerViewVisibility, Mode=OneWay}" Padding="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Album Art -->
                    <Viewbox Grid.Row="0" Margin="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                        <Grid>
                            <Border CornerRadius="12" Background="{ThemeResource LayerFillColorAltBrush}" Width="250" Height="250">
                                <Image Stretch="UniformToFill" Source="{Binding CurrentSongThumbnail}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="No Artwork Available" />
                                    </ToolTipService.ToolTip>
                                </Image>
                            </Border>
                            <!-- Fallback Icon behind image -->
                            <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE8D6;" FontSize="64" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.FallbackIconVisibility, Mode=OneWay}" />
                        </Grid>
                    </Viewbox>

                    <!-- Title -->
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CurrentSongTitle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>

                    <!-- Artist -->
                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.CurrentSongArtist, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,15"/>

                    <!-- Scrub Bar -->
                    <Grid Grid.Row="3" Margin="20,0,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CurrentSongPositionText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        
                        <Slider x:Name="SongPositionSlider"
                                Grid.Column="1" 
                                Minimum="0" 
                                Maximum="{x:Bind ViewModel.CurrentSongDurationSeconds, Mode=OneWay}" 
                                Value="{x:Bind ViewModel.CurrentSongPositionSeconds, Mode=TwoWay}"
                                ThumbToolTipValueConverter="{StaticResource TimeSpanConverter}"
                                PointerCaptureLost="SongPositionSlider_PointerCaptureLost"
                                VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CurrentSongDurationText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                    </Grid>
                </Grid>

                <!-- COMPANION VIEW -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{x:Bind ViewModel.CompanionViewVisibility, Mode=OneWay}" Padding="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <!-- Back to the mixer -->
                        <Button Content="&#xE72B;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Background="Transparent"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                BorderThickness="0"
                                Padding="5"
                                FontSize="18"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="CloseCompanionButton_Click"
                                ToolTipService.ToolTip="Back" AutomationProperties.Name="Back"/>

                        <TextBlock Text="Mobile Companion"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- OFF STATE: Power Button -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.CompanionPowerButtonVisibility, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                            <TextBlock Text="Server Offline"
                                       FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>

                            <!-- Shown when the server couldn't start -->
                            <InfoBar IsOpen="True"
                                     IsClosable="False"
                                     Severity="Warning"
                                     MaxWidth="320"
                                     Message="{x:Bind ViewModel.CompanionErrorMessage, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.CompanionErrorVisibility, Mode=OneWay}"/>
                            
                            <!-- Huge Power Button -->
                            <Button Width="120" Height="120" CornerRadius="60"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    IsEnabled="{x:Bind ViewModel.CanStartCompanion, Mode=OneWay}"
                                    Click="CompanionPowerOn_Click"
                                    ToolTipService.ToolTip="Turn on the companion server" AutomationProperties.Name="Turn on the companion server">
                                <TextBlock Text="&#xE7E8;"
                                           FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                           FontSize="50"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>

                            <TextBlock Text="Click to power on"
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.CompanionPowerHintVisibility, Mode=OneWay}"/>

                            <!-- First start only: Windows asks for admin permission once to open the port -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" MaxWidth="300"
                                        Visibility="{x:Bind ViewModel.CompanionStartingVisibility, Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsCompanionStarting, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Waiting for Windows permission. Choose Yes on the admin prompt (only needed once)."
                                           FontSize="13" TextWrapping="Wrap" MaxWidth="270"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ON STATE: QR Code & Info -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.CompanionActiveUiVisibility, Mode=OneWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Padding="0,5">
                                
                                <TextBlock Text="Scan to connect" 
                                           FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           HorizontalAlignment="Center"/>

                                <!-- QR code generated locally on this PC -->
                                <Border CornerRadius="8" HorizontalAlignment="Center" Background="White">
                                    <Image Width="120" Height="120" Stretch="Uniform"
                                           Source="{x:Bind ViewModel.CompanionQrImage, Mode=OneWay}"/>
                                </Border>

                                <TextBlock Text="{x:Bind ViewModel.CompanionPairingCode, Mode=OneWay}" 
                                           FontSize="32" FontWeight="Bold" 
                                           CharacterSpacing="200"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                                           HorizontalAlignment="Center" Margin="0,2,0,2"/>

                                <TextBlock Text="{x:Bind ViewModel.CompanionClientText, Mode=OneWay}" 
                                           FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" 
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>

                                <TextBlock Text="{x:Bind ViewModel.CompanionServerUrl, Mode=OneWay}" 
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           HorizontalAlignment="Center" IsTextSelectionEnabled="True"/>

                                <Button Content="Turn Off Server"
                                        Margin="0,8,0,0" Padding="12,4"
                                        HorizontalAlignment="Center"
                                        Click="CompanionPowerOff_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- BLUETOOTH VIEW: what it shows (and the Windows device watchers behind it) only exists while it's open -->
                <Grid Grid.Row="0" Grid.RowSpan="2"
                      Visibility="{x:Bind ViewModel.BluetoothViewVisibility, Mode=OneWay}"
                      Padding="15,15,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <!-- Back to the mixer -->
                        <Button Content="&#xE72B;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Background="Transparent"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                BorderThickness="0"
                                Padding="5"
                                FontSize="18"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="CloseBluetoothButton_Click"
                                ToolTipService.ToolTip="Back" AutomationProperties.Name="Back"/>

                        <TextBlock Text="Bluetooth"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                        <StackPanel Spacing="10" Padding="0,0,0,10">

                            <!-- Still asking Windows about the radio. Only active while it's showing: a hidden
                                 spinner that's still active keeps animating and using CPU in the background -->
                            <ProgressRing IsActive="{x:Bind ViewModel.Bluetooth.IsLoading, Mode=OneWay, FallbackValue=False}" Width="24" Height="24" Margin="0,30,0,0"
                                          HorizontalAlignment="Center"
                                          Visibility="{x:Bind ViewModel.Bluetooth.LoadingVisibility, Mode=OneWay}"/>

                            <!-- No Bluetooth on this PC -->
                            <StackPanel Spacing="8" Margin="0,30,0,0" HorizontalAlignment="Center" MaxWidth="300"
                                        Visibility="{x:Bind ViewModel.Bluetooth.UnavailableVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE702;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Bluetooth isn't available on this PC"
                                           FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="If it should be, check it hasn't been switched off in Device Manager, or try Windows' own Bluetooth settings."
                                           FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <HyperlinkButton Content="Open Windows Bluetooth settings" HorizontalAlignment="Center" Click="OpenBluetoothSettings_Click"/>
                            </StackPanel>

                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.Bluetooth.AvailableVisibility, Mode=OneWay}">

                                <!-- Something went wrong -->
                                <InfoBar Severity="Warning"
                                         IsClosable="True"
                                         IsOpen="{x:Bind ViewModel.Bluetooth.HasMessage, Mode=OneWay}"
                                         Message="{x:Bind ViewModel.Bluetooth.Message, Mode=OneWay}"
                                         CloseButtonClick="BluetoothMessage_CloseButtonClick"/>

                                <!-- On/off -->
                                <Grid Padding="12,6" CornerRadius="8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE702;" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Bluetooth" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <ToggleSwitch x:Name="BluetoothRadioToggle" AutomationProperties.Name="Bluetooth on or off"
                                                  Grid.Column="2"
                                                  MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  OnContent="On" OffContent="Off"
                                                  IsOn="{x:Bind ViewModel.Bluetooth.IsRadioOn, Mode=OneWay}"
                                                  IsEnabled="{x:Bind ViewModel.Bluetooth.CanToggleRadio, Mode=OneWay}"
                                                  Toggled="BluetoothRadioToggle_Toggled"/>
                                </Grid>

                                <!-- Pairing question (check or type a PIN) -->
                                <Border Padding="12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                                        Visibility="{x:Bind ViewModel.Bluetooth.PromptVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.Bluetooth.PromptText, Mode=OneWay}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBox x:Name="BluetoothPinBox"
                                                 PlaceholderText="PIN"
                                                 KeyDown="BluetoothPinBox_KeyDown"
                                                 Visibility="{x:Bind ViewModel.Bluetooth.PinEntryVisibility, Mode=OneWay}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Visibility="{x:Bind ViewModel.Bluetooth.PromptButtonsVisibility, Mode=OneWay}">
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    Content="{x:Bind ViewModel.Bluetooth.PromptAcceptText, Mode=OneWay}"
                                                    Click="BluetoothPromptAccept_Click"/>
                                            <Button Content="Cancel" Click="BluetoothPromptCancel_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Paired devices -->
                                <TextBlock Text="Your devices" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock Text="No devices paired yet. Use Search below to add one."
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.Bluetooth.NoPairedDevicesVisibility, Mode=OneWay}"/>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Bluetooth.PairedDevices, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6" Padding="12,8" CornerRadius="8"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="{Binding ConnectButtonText}"
                                                        Visibility="{Binding ConnectButtonVisibility}"
                                                        IsEnabled="{Binding CanAct}"
                                                        Margin="8,0,0,0" Padding="10,4"
                                                        VerticalAlignment="Center"
                                                        Click="BluetoothConnect_Click"/>
                                                <Button Grid.Column="3"
                                                        Content="&#xE712;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        Width="32" Height="32"
                                                        Padding="0" MinWidth="0" MinHeight="0"
                                                        Margin="4,0,0,0"
                                                        Background="Transparent"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding IsIdle}"
                                                        Click="BluetoothDeviceMore_Click"
                                                        ToolTipService.ToolTip="More options" AutomationProperties.Name="More options"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Finding new devices -->
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="Add a device" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button HorizontalAlignment="Right" Padding="10,4"
                                            Content="{x:Bind ViewModel.Bluetooth.ScanButtonText, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.Bluetooth.CanScan, Mode=OneWay}"
                                            Click="BluetoothScan_Click"/>
                                </Grid>

                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Bluetooth.ScanningVisibility, Mode=OneWay}">
                                    <!-- Like the spinner above, only animates while searching -->
                                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.Bluetooth.IsScanning, Mode=OneWay, FallbackValue=False}"/>
                                    <TextBlock Text="Looking for devices. Make sure yours is switched on and in pairing mode."
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Bluetooth.NearbyDevices, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6" Padding="12,8" CornerRadius="8"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding NearbyStatusText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Pair"
                                                        IsEnabled="{Binding CanAct}"
                                                        Margin="8,0,0,0" Padding="10,4"
                                                        VerticalAlignment="Center"
                                                        Click="BluetoothPair_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Windows' own Bluetooth page, styled like the device cards above -->
                                <Button Margin="0,6,0,0" Padding="12,8" CornerRadius="8"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Click="OpenBluetoothSettings_Click"
                                        AutomationProperties.Name="More Bluetooth settings">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="More Bluetooth settings" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Opens Windows' own Bluetooth settings" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>


                <!-- Media Controls -->
                <StackPanel x:Name="MediaControlsPanel" Grid.Row="2" Margin="0,10,0,-10" Visibility="{x:Bind ViewModel.MediaControlsVisibility, Mode=OneWay}">
                    <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,8"/>
                    
                    <Grid>
                        <!-- Music Player Mode Toggle -->
                        <Button x:Name="MusicPlayerToggleButton"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="&#xE8D6;" 
                                FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                                Background="Transparent" 
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                BorderThickness="0" 
                                FontSize="18"
                                Width="36" Height="36"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Click="ToggleMusicPlayerMode_Click" 
                                ToolTipService.ToolTip="Toggle Music Player View" AutomationProperties.Name="Toggle Music Player View" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <!-- Previous -->
                        <Button Content="&#xE892;" 
                                FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" 
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" 
                                CornerRadius="18"
                                FontSize="14"
                                Width="36" Height="36"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Click="MediaPrevious_Click" 
                                ToolTipService.ToolTip="Previous Track" AutomationProperties.Name="Previous Track" />

                        <!-- Play/Pause -->
                        <Button Background="{ThemeResource ControlFillColorSecondaryBrush}" 
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" 
                                CornerRadius="18"
                                Width="36" Height="36"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Click="MediaPlayPause_Click" 
                                ToolTipService.ToolTip="Play / Pause" AutomationProperties.Name="Play / Pause">
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE768;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE769;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Next -->
                        <Button Content="&#xE893;" 
                                FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" 
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" 
                                CornerRadius="18"
                                FontSize="14"
                                Width="36" Height="36"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Click="MediaNext_Click" 
                                ToolTipService.ToolTip="Next Track" AutomationProperties.Name="Next Track" />

                        <!-- Mute -->
                        <Button Content="&#xE74F;" 
                                FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" 
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" 
                                CornerRadius="18"
                                FontSize="14"
                                Width="36" Height="36"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Click="MediaMute_Click" 
                                ToolTipService.ToolTip="Mute System" AutomationProperties.Name="Mute System" />
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Settings Content -->
            <Grid x:Name="SettingsContentGrid" Grid.Row="1" Visibility="Collapsed" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="&#xE72B;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Background="Transparent"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            BorderThickness="0"
                            Padding="5"
                            FontSize="18"
                            Margin="0,0,10,0"
                            Click="CloseSettingsButton_Click"
                            ToolTipService.ToolTip="Back" AutomationProperties.Name="Back"/>
                    <TextBlock Text="Settings"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search: hides what doesn't match and opens what does -->
                <AutoSuggestBox x:Name="SettingsSearchBox"
                                Grid.Row="1"
                                PlaceholderText="Search settings"
                                QueryIcon="Find"
                                Margin="0,0,0,6"
                                AutomationProperties.Name="Search settings"
                                TextChanged="SettingsSearchBox_TextChanged"/>

                <!-- The negative margin and matching padding put the scroll bar in the window's margin, clear of the cards -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" Padding="0,0,16,0">
                    <!-- Each card's Tag holds extra words people might search for; group headings are tagged #group -->
                    <StackPanel x:Name="SettingsStackPanel" Spacing="6" Padding="0,0,0,10">

                        <TextBlock x:Name="NoSettingsMatchText"
                                   Text="No settings match your search."
                                   Visibility="Collapsed"
                                   Margin="2,16,0,0"
                                   Style="{StaticResource SettingsDescriptionStyle}"/>

                        <!-- ===== LOOK ===== -->
                        <Button Tag="#group" Background="Transparent" BorderThickness="0" Padding="2,6" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Look" Click="SettingsGroupHeader_Click" ToolTipService.ToolTip="Show or hide Look settings"><Grid><TextBlock Text="Look" Margin="0" Style="{StaticResource SettingsGroupHeaderStyle}"/><FontIcon Glyph="&#xE70D;" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Button>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="theme dark mode light mode colour color appearance">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Theme" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Follow Windows, or always light or dark." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      VerticalAlignment="Center"
                                      MinWidth="110"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                      AutomationProperties.Name="Theme"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="opacity transparent transparency see-through see through window">
                            <StackPanel>
                                <TextBlock Text="Window opacity" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Make SoundBar see-through so you can still see what's behind it." Style="{StaticResource SettingsDescriptionStyle}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="30" Maximum="100" StepFrequency="1"
                                            IsThumbToolTipEnabled="False"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Window opacity"
                                            Value="{x:Bind ViewModel.WindowOpacity, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.WindowOpacityText, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               MinWidth="40" TextAlignment="Right"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <Button Grid.Column="2"
                                            Content="&#xE72C;"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" Margin="5,0,0,0"
                                            Click="ResetOpacity_Click"
                                            ToolTipService.ToolTip="Reset to 100%"
                                            AutomationProperties.Name="Reset opacity to 100%"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="active app highlight focus hotkeys">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Active app highlight" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Highlights the app your volume hotkeys are controlling." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="Active app highlight"
                                          IsOn="{Binding EnableFocusHighlight, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="custom background wallpaper image picture photo">
                            <StackPanel>
                                <TextBlock Text="Custom background" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Put a .jpg or .png in the backgrounds folder to personalise SoundBar." Style="{StaticResource SettingsDescriptionStyle}"/>
                                <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Open Folder" HorizontalAlignment="Stretch" Click="OpenBackgroundFolder_Click"/>
                                    <Button Grid.Column="1" Content="Reload" HorizontalAlignment="Stretch" Click="ReloadBackground_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ===== MAIN PAGE ===== -->
                        <Button Tag="#group" Background="Transparent" BorderThickness="0" Padding="2,6" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Main page" Click="SettingsGroupHeader_Click" ToolTipService.ToolTip="Show or hide Main page settings"><Grid><TextBlock Text="Main page" Margin="0" Style="{StaticResource SettingsGroupHeaderStyle}"/><FontIcon Glyph="&#xE70D;" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Button>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="layout sections show hide output device input microphone mic master volume active apps media controls">
                            <StackPanel>
                                <TextBlock Text="Show on the main page" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Hidden sections still work with hotkeys." Style="{StaticResource SettingsDescriptionStyle}"/>
                                <Grid Margin="0,6,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Output device" IsChecked="{x:Bind ViewModel.ShowOutputDevice, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Microphone" IsChecked="{x:Bind ViewModel.ShowInputDevice, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Master volume" IsChecked="{x:Bind ViewModel.ShowMasterVolume, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Active apps" IsChecked="{x:Bind ViewModel.ShowActiveApps, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="2" Grid.Column="0" Content="Media controls" IsChecked="{x:Bind ViewModel.ShowMediaControls, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="title bar buttons classic menu always on top pin mobile companion phone bluetooth">
                            <StackPanel>
                                <TextBlock Text="Title bar" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Tuck these into the &#x22EF; menu, or give each its own button like before." Style="{StaticResource SettingsDescriptionStyle}"/>
                                <CheckBox Margin="0,6,0,0" Content="Separate buttons (classic title bar)" IsChecked="{x:Bind ViewModel.UseClassicTitleBar, Mode=TwoWay}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Always on Top" IsChecked="{x:Bind ViewModel.ShowPinButton, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Mobile Companion" IsChecked="{x:Bind ViewModel.ShowCompanionButton, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Bluetooth" IsChecked="{x:Bind ViewModel.ShowBluetoothButton, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ===== SOUND ===== -->
                        <Button Tag="#group" Background="Transparent" BorderThickness="0" Padding="2,6" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Sound" Click="SettingsGroupHeader_Click" ToolTipService.ToolTip="Show or hide Sound settings"><Grid><TextBlock Text="Sound" Margin="0" Style="{StaticResource SettingsGroupHeaderStyle}"/><FontIcon Glyph="&#xE70D;" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Button>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="do not disturb dnd mute quiet notifications system sounds">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Do Not Disturb" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Mutes system sounds and notification sounds." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="Do Not Disturb"
                                          IsOn="{x:Bind ViewModel.IsDoNotDisturbEnabled, Mode=TwoWay}"
                                          Toggled="DndToggleButton_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="hearing protection loudness loud volume warning ears">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Loudness warning" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Warns you if the master volume stays above 85% for a while." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="Loudness warning"
                                          IsOn="{x:Bind ViewModel.IsLoudnessWarningEnabled, Mode=TwoWay}"/>
                        </Grid>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  Tag="global hotkeys keyboard shortcuts keys volume up down mute microphone">
                            <Expander.Header>
                                <StackPanel Padding="0,8">
                                    <TextBlock Text="Global hotkeys" Style="{StaticResource SettingsTitleStyle}"/>
                                    <TextBlock Text="Control the app you're using without leaving it." Style="{StaticResource SettingsDescriptionStyle}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Volume up (active app)" VerticalAlignment="Center" Style="{StaticResource SettingsTitleStyle}"/>
                                    <Button Grid.Column="1" MinWidth="120" Content="{x:Bind ViewModel.VolumeUpHotkey, Mode=OneWay}" Click="RecordVolumeUpHotkey_Click" AutomationProperties.Name="Volume up hotkey"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Volume down (active app)" VerticalAlignment="Center" Style="{StaticResource SettingsTitleStyle}"/>
                                    <Button Grid.Column="1" MinWidth="120" Content="{x:Bind ViewModel.VolumeDownHotkey, Mode=OneWay}" Click="RecordVolumeDownHotkey_Click" AutomationProperties.Name="Volume down hotkey"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mute (active app)" VerticalAlignment="Center" Style="{StaticResource SettingsTitleStyle}"/>
                                    <Button Grid.Column="1" MinWidth="120" Content="{x:Bind ViewModel.MuteHotkey, Mode=OneWay}" Click="RecordMuteHotkey_Click" AutomationProperties.Name="Mute hotkey"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mute microphone" VerticalAlignment="Center" Style="{StaticResource SettingsTitleStyle}"/>
                                    <Button Grid.Column="1" MinWidth="120" Content="{x:Bind ViewModel.InputMuteHotkey, Mode=OneWay}" Click="RecordInputMuteHotkey_Click" AutomationProperties.Name="Mute microphone hotkey"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="system sounds windows sound scheme notification event">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="System sounds" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Windows' sound schemes and notification sounds." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open" VerticalAlignment="Center" Click="OpenSystemSounds_Click"
                                    AutomationProperties.Name="Open system sounds"/>
                        </Grid>

                        <!-- ===== APPS ===== -->
                        <Button Tag="#group" Background="Transparent" BorderThickness="0" Padding="2,6" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Apps" Click="SettingsGroupHeader_Click" ToolTipService.ToolTip="Show or hide Apps settings"><Grid><TextBlock Text="Apps" Margin="0" Style="{StaticResource SettingsGroupHeaderStyle}"/><FontIcon Glyph="&#xE70D;" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Button>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  Tag="hidden apps unhide mixer">
                            <Expander.Header>
                                <StackPanel Padding="0,8">
                                    <TextBlock Text="{x:Bind ViewModel.HiddenAppsTitle, Mode=OneWay}" Style="{StaticResource SettingsTitleStyle}"/>
                                    <TextBlock Text="Apps you've hidden from the mixer." Style="{StaticResource SettingsDescriptionStyle}"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding HiddenApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Button Grid.Column="1" Content="Unhide" Click="UnhideAppButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  Tag="background apps allow">
                            <Expander.Header>
                                <StackPanel Padding="0,8">
                                    <TextBlock Text="{x:Bind ViewModel.BackgroundAppsTitle, Mode=OneWay}" Style="{StaticResource SettingsTitleStyle}"/>
                                    <TextBlock Text="Running in the background, not playing sound yet." Style="{StaticResource SettingsDescriptionStyle}"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding SystemBackgroundApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Button Grid.Column="1" Content="Allow" Click="AllowBackgroundAppButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- ===== GENERAL ===== -->
                        <Button Tag="#group" Background="Transparent" BorderThickness="0" Padding="2,6" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="General" Click="SettingsGroupHeader_Click" ToolTipService.ToolTip="Show or hide General settings"><Grid><TextBlock Text="General" Margin="0" Style="{StaticResource SettingsGroupHeaderStyle}"/><FontIcon Glyph="&#xE70D;" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Button>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="run at startup start with windows boot login launch automatically">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Run at startup" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Start SoundBar in the background when you sign in." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="Run at startup"
                                          IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="desktop shortcut icon">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Desktop shortcut" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Put a fresh SoundBar shortcut on your desktop." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Create" VerticalAlignment="Center"
                                    Click="{x:Bind ViewModel.CreateDesktopShortcut}"
                                    AutomationProperties.Name="Create desktop shortcut"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="advanced configuration config json file port companion server">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Advanced settings file" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="Edit hidden settings (like the companion port) in config.json. Changes apply when you save." Style="{StaticResource SettingsDescriptionStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open" VerticalAlignment="Center"
                                    Click="{x:Bind ViewModel.OpenSettingsFile}"
                                    AutomationProperties.Name="Open config.json"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsCardStyle}" Tag="about updates version help user guide readme release notes what's new">
                            <StackPanel>
                                <TextBlock Text="About SoundBar" Style="{StaticResource SettingsTitleStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" Style="{StaticResource SettingsDescriptionStyle}"/>
                                <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="User Guide" HorizontalAlignment="Stretch" Click="UserGuide_Click"
                                            ToolTipService.ToolTip="Walks through every feature, with pictures (opens in your browser)"/>
                                    <Button Grid.Column="1" Content="Release Notes" HorizontalAlignment="Stretch" Click="VersionHyperlink_Click"
                                            ToolTipService.ToolTip="What's new in this version (opens in your browser)"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer (hidden while Settings is open: the About card shows the version there, and this would sit over the cards) -->
            <StackPanel x:Name="FooterPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,5" Spacing="8">
                <!-- App Version (Global) - click to open this version's release notes -->
                <HyperlinkButton Content="{x:Bind ViewModel.AppVersionText, Mode=OneWay}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 FontSize="10"
                                 Padding="4,2"
                                 MinHeight="0" MinWidth="0"
                                 VerticalAlignment="Center"
                                 Click="VersionHyperlink_Click"
                                 ToolTipService.ToolTip="View release notes for this version"/>
            </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
