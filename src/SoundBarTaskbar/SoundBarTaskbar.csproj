<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SoundBar Taskbar: the small helper that shows the volume and microphone state on the Windows taskbar.

    It's plain Win32 with no WinUI, so it stays tiny and can run all day on its own. It ships inside the
    normal SoundBar download: SoundBar.csproj references this project, so its few files land next to
    SoundBar.exe and share the .NET runtime that's already in that folder.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SoundBarTaskbar</RootNamespace>
    <AssemblyName>SoundBarTaskbar</AssemblyName>
    <!-- The name Task Manager shows -->
    <AssemblyTitle>SoundBar Taskbar</AssemblyTitle>
    <Product>SoundBar</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\SoundBar\Assets\SoundBar.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <UseRidGraph>true</UseRidGraph>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>NU1701</NoWarn>
    <!-- Keeps memory low for an app that sits idle all day -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SoundBar.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- The same version SoundBar uses, so the one copy of CSCore.dll in the folder serves both -->
    <PackageReference Include="CSCore" Version="1.2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TaskbarHelperInfo.cs" Link="Shared\TaskbarHelperInfo.cs" />
    <Compile Include="..\Shared\ShortcutFile.cs" Link="Shared\ShortcutFile.cs" />
  </ItemGroup>

</Project>
