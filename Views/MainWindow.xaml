<Window x:Class="SoundBar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2D2D30" 
            BorderBrush="#444444" 
            BorderThickness="1"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">

                <Grid x:Name="TitleBarGrid" Margin="-20,-20,-20,15" Padding="20,20,20,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="SoundBar" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button x:Name="PinButton"
                            Grid.Column="1"
                            Content="&#xE718;" 
                            FontFamily="Segoe Fluent Icons"
                            Width="36" Height="36"
                            Padding="0" MinWidth="0" MinHeight="0"
                            Background="Transparent"
                            Foreground="#555555"
                            BorderThickness="0"
                            FontSize="16"
                            Margin="0,0,5,0"
                            Click="PinButton_Click"
                            ToolTipService.ToolTip="Always on Top"/>

                    <Button x:Name="MinimizeButton"
                            Grid.Column="2"
                            Content="&#xE921;" 
                            FontFamily="Segoe Fluent Icons"
                            Width="36" Height="36"
                            Padding="0" MinWidth="0" MinHeight="0"
                            Background="Transparent"
                            Foreground="#AAAAAA"
                            BorderThickness="0"
                            FontSize="14"
                            Click="MinimizeButton_Click"/>

                    <Button Grid.Column="3"
                            Content="&#xE711;" 
                            FontFamily="Segoe Fluent Icons"
                            Width="36" Height="36"
                            Padding="0" MinWidth="0" MinHeight="0"
                            Background="Transparent"
                            Foreground="#AAAAAA"
                            BorderThickness="0"
                            FontSize="14"
                            Click="CloseButton_Click"/>
                </Grid>

                <TextBlock Text="Master Volume" 
                           Foreground="#DDDDDD" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0"
                            Minimum="0" 
                            Maximum="100" 
                            Value="{Binding MasterVolumePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" 
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right">
                        <Run Text="{Binding MasterVolumePercentage}" /><Run Text="%" />
                    </TextBlock>
                </Grid>

                <Border Height="1" Background="#555555" Margin="0,20,0,10"/>

                <TextBlock Text="Active Apps" 
                           Foreground="#DDDDDD" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}" 
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <Slider Grid.Column="1" 
                                        Minimum="0" 
                                        Maximum="100" 
                                        Value="{Binding VolumePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="10,0"/>

                                <TextBlock Grid.Column="2" 
                                           Foreground="#AAAAAA"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right">
                                    <Run Text="{Binding VolumePercentage}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>